---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import SkillMiniDiagram from '../../components/SkillMiniDiagram.astro';
import { skills } from '../../data/site';

export function getStaticPaths() {
  return skills.map(skill => ({ params: { slug: skill.slug }, props: { skill } }));
}
const { skill } = Astro.props;
---
<BaseLayout title={`${skill.name} · Shuijin Lin`} description={skill.summary}>
  <section class="page-hero shell">
    <div class="eyebrow">{skill.type}</div>
    <h1><code>{skill.name}</code></h1>
    <p>{skill.summary}</p>
    <span class="proof-chip detail-proof">{skill.proof}</span>
  </section>
  <section class="section shell skill-detail">
    <div>
      <div class="eyebrow">Architecture preview</div>
      <h2>How the component reasons about work</h2>
      <SkillMiniDiagram skill={skill} />
    </div>
    <div>
      <div class="eyebrow">Problem</div>
      <h2>Why this exists</h2>
      <p class="large-copy">{skill.problem}</p>
    </div>
    <div>
      <div class="eyebrow">Workflow</div>
      <div class="vertical-flow">
        {skill.workflow.map((step: string, index: number) => <><div class="flow-step">{step}</div>{index < skill.workflow.length - 1 && <div class="flow-down">↓</div>}</>)}
      </div>
    </div>
    <div>
      <div class="eyebrow">Design principles</div>
      <div class="tag-row">{skill.principles.map((p: string) => <Tag>{p}</Tag>)}</div>
      <div class="disclosure"><strong>Public disclosure boundary</strong><p>This portfolio presents architecture, role boundaries and sanitized examples only. Credentials, internal infrastructure, private prompts and unpublished scientific details are intentionally excluded.</p></div>
    </div>
  </section>
</BaseLayout>
