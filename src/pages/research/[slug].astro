---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import ResearchVisual from '../../components/ResearchVisual.astro';
import { researchProjects } from '../../data/site';

export function getStaticPaths() {
  return researchProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} · Shuijin Lin`} description={project.summary}>
  <section class="page-hero shell">
    <div class="eyebrow">{project.eyebrow}</div>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
    <div class="tag-row">{project.tags.map((tag: string) => <Tag>{tag}</Tag>)}</div>
  </section>
  <section class="section shell research-detail-visual">
    <ResearchVisual kind={project.visual} />
  </section>
  <section class="section shell prose-grid">
    <div>
      <h2>What I work on</h2>
      <ul class="detail-list">{project.bullets.map((bullet: string) => <li>{bullet}</li>)}</ul>
    </div>
    <aside class="side-note">
      <div class="eyebrow">Research standard</div>
      <h3>Scientific correctness before automation</h3>
      <p>Training, inference, OOF aggregation and statistical analysis are validated stage by stage instead of being treated as a black-box pipeline.</p>
      {project.links?.map((link: {label:string;href:string}) => <a class="button" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
    </aside>
  </section>
</BaseLayout>
