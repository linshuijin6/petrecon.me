---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Publications & Open Source · Shuijin Lin">
  <section class="page-hero shell">
    <div class="eyebrow">Publications & Open Source</div>
    <h1>Research outputs</h1>
    <p>Selected public work connecting scientific contributions with inspectable implementation.</p>
  </section>

  <section class="section shell">
    <article class="publication">
      <div class="publication-year">2026</div>
      <div>
        <div class="eyebrow">First author · IEEE Early Access · Open Source</div>
        <h2>DuSS-PET: Self-Supervised Low-Dose PET Reconstruction Using Pseudo-Dual-Domain Consistency Without Paired Data</h2>
        <p><em>IEEE Transactions on Radiation and Plasma Medical Sciences</em>, Early Access, 2026. DOI: 10.1109/TRPMS.2026.3696317.</p>
        <div class="hero-actions">
          <a class="button primary" href="https://doi.org/10.1109/TRPMS.2026.3696317" target="_blank" rel="noreferrer">Paper / DOI ↗</a>
          <a class="button" href="https://github.com/linshuijin6/DuSS-PET" target="_blank" rel="noreferrer">Open source code ↗</a>
          <a class="button" href="/research/duss-pet">Project overview</a>
        </div>
      </div>
    </article>

    <article class="publication">
      <div class="publication-year">2026</div>
      <div>
        <div class="eyebrow">Co-author · arXiv preprint · Multi-tracer PET synthesis</div>
        <h2>Precision Synthesis of Multi-Tracer PET via VLM-Modulated Rectified Flow for Stratifying Mild Cognitive Impairment</h2>
        <p class="publication-authors">Tuo Liu, <strong>Shuijin Lin</strong>, Shaozhen Yan, Haifeng Wang, Jie Lu, Jianhua Ma, Chunfeng Lian.</p>
        <p>
          <em>arXiv:2604.11176</em> [cs.CV], v2, 2026. DIReCT++ combines 3D rectified flow with a domain-adapted BiomedCLIP encoder for personalized
          <sup>18</sup>F-AV-45 / <sup>18</sup>F-FDG PET synthesis from MRI and clinical information, with downstream MCI stratification.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="https://arxiv.org/abs/2604.11176" target="_blank" rel="noreferrer">arXiv ↗</a>
          <a class="button" href="https://doi.org/10.48550/arXiv.2604.11176" target="_blank" rel="noreferrer">arXiv DOI ↗</a>
          <a class="button" href="https://github.com/ladderlab-xjtu/DIReCT-PLUS" target="_blank" rel="noreferrer">Project code ↗</a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
