---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Publications & Open Source · Shuijin Lin">
  <section class="page-hero shell">
    <div class="eyebrow">Publications & Open Source</div>
    <h1>Research outputs</h1>
    <p>Selected public work connecting scientific contributions with inspectable implementation.</p>
  </section>

  <section class="section shell">
    <article class="publication">
      <div class="publication-year">2026</div>
      <div>
        <div class="eyebrow">First author · IEEE Early Access · Open Source</div>
        <h2>DuSS-PET: Self-Supervised Low-Dose PET Reconstruction Using Pseudo-Dual-Domain Consistency Without Paired Data</h2>

        <div class="publication-meta">
          <div class="publication-meta-row">
            <span class="publication-meta-label">Authors</span>
            <p>
              <a href="https://ieeexplore.ieee.org/author/187679001343241" target="_blank" rel="noreferrer"><strong>Shuijin Lin</strong></a>;
              <a href="https://ieeexplore.ieee.org/author/37065440800" target="_blank" rel="noreferrer">Yuzhu He</a>;
              <a href="https://ieeexplore.ieee.org/author/37086224283" target="_blank" rel="noreferrer">Yongbo Wang</a>;
              <a href="https://ieeexplore.ieee.org/author/37579163800" target="_blank" rel="noreferrer">Jianhua Ma</a>;
              <a href="https://ieeexplore.ieee.org/author/37086383390" target="_blank" rel="noreferrer">Fan Wan</a>.
            </p>
          </div>

          <div class="publication-meta-row">
            <span class="publication-meta-label">Journal</span>
            <p><em>IEEE Transactions on Radiation and Plasma Medical Sciences</em>, Early Access, 2026. DOI: 10.1109/TRPMS.2026.3696317.</p>
          </div>

          <div class="publication-meta-row">
            <span class="publication-meta-label">Keywords</span>
            <p class="publication-keywords">
              <a href="https://ieeexplore.ieee.org/search/searchresult.jsp?matchBoolean=true&queryText=%22Index%20Terms%22%3APositron%20emission%20tomography&newsearch=true" target="_blank" rel="noreferrer">Positron emission tomography</a>,
              <a href="https://ieeexplore.ieee.org/search/searchresult.jsp?matchBoolean=true&queryText=%22Index%20Terms%22%3AModeling&newsearch=true" target="_blank" rel="noreferrer">Modeling</a>,
              <a href="https://ieeexplore.ieee.org/search/searchresult.jsp?matchBoolean=true&queryText=%22Index%20Terms%22%3AImage%20denoising&newsearch=true" target="_blank" rel="noreferrer">Image denoising</a>,
              <span>Noise measurement</span>.
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <a class="button primary" href="https://doi.org/10.1109/TRPMS.2026.3696317" target="_blank" rel="noreferrer">Paper / DOI ↗</a>
          <a class="button" href="https://github.com/linshuijin6/DuSS-PET" target="_blank" rel="noreferrer">Open source code ↗</a>
          <a class="button" href="/research/duss-pet">Project overview</a>
        </div>
      </div>
    </article>

    <article class="publication">
      <div class="publication-year">2026</div>
      <div>
        <div class="eyebrow">Co-author · arXiv preprint · Multi-tracer PET synthesis</div>
        <h2>Precision Synthesis of Multi-Tracer PET via VLM-Modulated Rectified Flow for Stratifying Mild Cognitive Impairment</h2>

        <div class="publication-meta">
          <div class="publication-meta-row">
            <span class="publication-meta-label">Authors</span>
            <p>Tuo Liu; <strong>Shuijin Lin</strong>; Shaozhen Yan; Haifeng Wang; Jie Lu; Jianhua Ma; Chunfeng Lian.</p>
          </div>

          <div class="publication-meta-row">
            <span class="publication-meta-label">Preprint</span>
            <p><em>arXiv:2604.11176</em> [cs.CV], v2, 2026.</p>
          </div>

          <div class="publication-meta-row">
            <span class="publication-meta-label">Keywords</span>
            <p class="publication-keywords">
              <span>Controllable Cross-Modal Synthesis</span>,
              <span>Domain-Knowledge Encoding</span>,
              <span>PET Imaging</span>,
              <span>Alzheimer’s Disease</span>.
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <a class="button primary" href="https://arxiv.org/abs/2604.11176" target="_blank" rel="noreferrer">arXiv ↗</a>
          <a class="button" href="https://doi.org/10.48550/arXiv.2604.11176" target="_blank" rel="noreferrer">arXiv DOI ↗</a>
          <a class="button" href="https://github.com/ladderlab-xjtu/DIReCT-PLUS" target="_blank" rel="noreferrer">Project code ↗</a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
