---
import Tag from './Tag.astro';
import ResearchVisual from './ResearchVisual.astro';
const { project } = Astro.props;
---
<article class="card research-card">
  <ResearchVisual kind={project.visual} />
  <div class="research-card-body">
    <div class="eyebrow">{project.eyebrow}</div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <div class="tag-row">{project.tags.map((tag: string) => <Tag>{tag}</Tag>)}</div>
    <div class="card-actions">
      <a class="text-link" href={`/research/${project.slug}`}>Explore project →</a>
      {project.links?.map((link: {label:string;href:string}) => <a class="text-link muted" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
    </div>
  </div>
</article>
